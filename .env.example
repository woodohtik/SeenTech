# ==============================================================================
#  SEEN POS — Environment Variables Template (.env.example)
# ==============================================================================
#  WARNING: This file is a TEMPLATE only. NEVER put real secrets here.
#  Copy this file to `.env.local` (git-ignored) and fill in real values there.
#  Any VITE_* variable is bundled into the public client JS — it must be a
#  PUBLIC key only. Never place a service_role / admin / private key in a VITE_*
#  variable.
# ==============================================================================

# --- Google Gemini AI ---
# Required for Gemini AI API calls. Keep server-side only.
GEMINI_API_KEY="<your-gemini-api-key>"

# Public URL where the app is hosted (OAuth callbacks, self links).
APP_URL="<your-app-url>"

# --- Firebase Client (public web config — safe to expose) ---
VITE_FIREBASE_API_KEY="<firebase-web-api-key>"
VITE_FIREBASE_AUTH_DOMAIN="<project>.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="<project-id>"
VITE_FIREBASE_STORAGE_BUCKET="<project>.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="<sender-id>"
VITE_FIREBASE_APP_ID="<app-id>"
# Web Push certificate key (Firebase Console -> Project Settings -> Cloud
# Messaging -> Web Push certificates). Public value. Without it,
# src/lib/pushNotifications.ts logs an error and push notifications never
# activate, but nothing else breaks.
VITE_FIREBASE_VAPID_KEY="<firebase-web-push-vapid-key>"

# --- Google Sign-In (public — safe to expose) ---
# OAuth 2.0 Client ID from Google Cloud Console (Credentials -> OAuth client
# ID -> Web application). Public value. Without it, Login.tsx simply skips
# rendering the Google sign-in button.
VITE_GOOGLE_CLIENT_ID="<google-oauth-client-id>.apps.googleusercontent.com"

# --- Firebase Admin (server-side ONLY — never exposed to the browser) ---
# TRANSITION-WINDOW ONLY (Stage 2 Supabase Auth cutover): only needed while the
# authMiddleware Firebase-token fallback is still in place. Remove once the
# cutover stabilizes and the fallback branch is deleted.
# Path to a service-account JSON file OR the JSON contents, injected at runtime
# from a secret manager. Do NOT commit the actual key file to the repo.
FIREBASE_SERVICE_ACCOUNT="<path-or-json-from-secret-manager>"
# Optional. Realtime Database URL for the Admin SDK (src/server/firebase-admin.ts).
# Falls back to `https://<project_id>.firebaseio.com` (derived from the
# service account) if unset, so only needed if your database lives at a
# non-default URL/region.
VITE_FIREBASE_DATABASE_URL="<https://your-project-default-rtdb.firebaseio.com>"

# --- Supabase ---
# URL of the Supabase project.
VITE_SUPABASE_URL="<https://your-project.supabase.co>"
# PUBLIC anon key ONLY (role: "anon"). This is shipped to the browser.
# DO NOT use the service_role key here — it bypasses all RLS.
VITE_SUPABASE_ANON_KEY="<supabase-anon-public-key>"
# service_role key (role: "service_role") — server-side ONLY, never VITE_*.
SUPABASE_SERVICE_ROLE_KEY="<server-side-only-service-role-key>"
# JWT secret (Project Settings -> API -> JWT Settings) — server-side ONLY.
# Used to verify Supabase-issued JWTs locally in authMiddleware.ts.
SUPABASE_JWT_SECRET="<server-side-only-supabase-jwt-secret>"

# --- Sentry (production error monitoring) ---
# DSN from your Sentry project (Settings -> Client Keys (DSN)). Public value,
# safe in a VITE_* var. Sentry.init() only runs when both this is set AND
# the build is a production build (src/lib/logger.ts initLogger()) -- leave
# unset in development/staging if you don't want dev noise in your Sentry
# project's issue stream.
VITE_SENTRY_DSN="<https://xxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX>"

# --- ZATCA e-invoicing (server-side ONLY — never exposed to the browser) ---
# Encrypts each tenant's ZATCA CSID private key + API secret before storing
# them in zatca_credentials (src/server/zatcaCrypto.ts, AES-256-GCM) --
# separate from ASSISTANT_ENCRYPTION_KEY on purpose, so a leak of one key
# doesn't expose both categories of secrets at once. Only actually needed
# once a tenant has completed real ZATCA onboarding (seen-zatca-readiness-
# task.md Phase 1) and Phase 2's signing is implemented; unset until then.
# Generate with `openssl rand -hex 32`.
ZATCA_ENCRYPTION_KEY="<server-side-only-32-byte-hex-or-base64-key>"

# --- Smart Assistant (server-side ONLY — never exposed to the browser) ---
# Encrypts each tenant's AI provider API key (src/server/assistantCrypto.ts,
# AES-256-GCM) before storing it in assistant_provider_credentials --
# separate from ZATCA_ENCRYPTION_KEY on purpose (see that section's comment).
# Generate with `openssl rand -hex 32`. Required as soon as any tenant
# configures the smart assistant; assistantCrypto.ts throws immediately if
# this is unset.
ASSISTANT_ENCRYPTION_KEY="<server-side-only-32-byte-hex-or-base64-key>"

# --- Payments (server-side ONLY — never exposed to the browser) ---
# Provider-agnostic subscription billing (src/services/paymentService.ts).
# The provider isn't finalized yet -- only set the secret key matching
# whichever one you choose; the other stays unset.
PAYMENT_PROVIDER="moyasar"
MOYASAR_SECRET_KEY="<moyasar-secret-key>"
PAYMOB_API_KEY="<paymob-api-key>"

# --- Customer Android app (public — bundled into the native build) ---
# Absolute API origin the bundled customer app (capacitor-customer/) talks
# to -- it has no live page origin to resolve relative fetch() calls
# against (src/lib/apiBase.ts). Only read on native builds; browser visits
# keep using relative paths regardless. Defaults to staging if unset, so
# a production Android build MUST set this explicitly or it will silently
# talk to staging.
VITE_CUSTOMER_API_ORIGIN="<https://www.seentech.io>"

# --- scripts/migrate.ts: Stage 2 user data migration (operator machine ONLY, not app runtime) ---
# Path to the JSON file from `firebase auth:export users.json --format=json`.
# Can also be passed as --export=<path> on the command line instead.
FIREBASE_AUTH_EXPORT_PATH="<path-to-firebase-auth-export.json>"
# Only needed if the export file's own `hash_config` is missing; `firebase
# auth:export` prints these to stdout when scrypt-hashed passwords are found.
FIREBASE_SCRYPT_SIGNER_KEY="<base64-signer-key>"
FIREBASE_SCRYPT_SALT_SEPARATOR="<base64-salt-separator>"
FIREBASE_SCRYPT_ROUNDS="<rounds>"
FIREBASE_SCRYPT_MEM_COST="<mem-cost>"

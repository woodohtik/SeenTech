rules_version = '2';
// Firestore is fully decommissioned — all data lives in Supabase Postgres
// (see MIGRATION_STAGE1.md). No live code path in this app reads or writes
// Firestore anymore. The previous ruleset here had several confirmed,
// unpatched vulnerabilities (a hardcoded-email super-admin bypass, a
// self-provisioning `staff` document write that allowed full cross-tenant
// takeover, and multiple tenant-blind permission checks that leaked one
// tenant's data to another's staff) left over from before the Supabase
// migration. Since nothing legitimate depends on Firestore access anymore,
// the correct fix is to deny all access outright rather than patch a rules
// engine for a database this app no longer uses.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
